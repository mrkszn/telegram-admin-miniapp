# Base URL of the telegram-waiter FastAPI backend.
# Local dev: http://localhost:8000 (uv run python -m api in telegram-waiter).
# Prod:      https://<your-backend-host>.
VITE_API_BASE_URL=http://localhost:8000

# Endpoint that exchanges Telegram initData for a JWT.
# POST ${VITE_API_BASE_URL}${VITE_AUTH_ENDPOINT} body: { init_data }.
VITE_AUTH_ENDPOINT=/admin/auth

# Endpoint that accepts a Telegram Login Widget payload outside the Mini App.
# POST ${VITE_API_BASE_URL}${VITE_AUTH_WEB_ENDPOINT}
# body: { id, first_name, last_name?, username?, photo_url?, auth_date, hash }.
VITE_AUTH_WEB_ENDPOINT=/admin/auth/web

# Telegram bot username (without the leading @) used by the Login Widget on
# the web subdomain (admin.<domain>). Required for web sign-in; ignored inside
# Telegram WebView. Set in @BotFather → /setdomain → admin.<domain> as well.
VITE_TELEGRAM_BOT_NAME=

# Free-form tag surfaced in UI / logs. Set to "production" on Vercel.
VITE_APP_ENV=development
